# Copy to .env (not .env.local: the Prisma CLI reads only .env) and fill in.
# Never commit real values. Per-environment values are in the README.

# Neon: pooled URL (host contains -pooler) for the app
DATABASE_URL=
# Neon: direct URL, used only by the Prisma CLI
DATABASE_URL_UNPOOLED=

# openssl rand -base64 32 (each; at least 32 bytes)
JWT_SECRET=
OAUTH_COOKIE_SECRET=

# http://localhost:3000 locally; unset on previews (falls back to https://$VERCEL_URL)
APP_URL=

# Google sign-in: strategy and button exist only when the client ID is set
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# GitHub sign-in: same rule
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# Vercel sends this to the daily cleanup cron
CRON_SECRET=

# Seed demo account (production password only ever lives in your shell)
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

# 1 = read job boards and recorded AI answers from fixtures/ instead of the network
USE_FIXTURES=

# Anthropic API key for the Pasted posting tab (claude-haiku-5-5). Unset = AI reading off.
# Use a dedicated key with a monthly spend limit set in the Anthropic console.
ANTHROPIC_API_KEY=
# off = turn AI reading off without removing the key
AI_MODE=
# Model override for reading postings and guessing job boards (default claude-haiku-5-5)
AI_MODEL=
# Model override for web search and page reading (default claude-sonnet-5-5)
AI_MODEL_LOCATE=
# Global daily AI spend cap in US dollars (default 2)
AI_DAILY_USD=
