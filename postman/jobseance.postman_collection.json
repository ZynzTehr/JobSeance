              "raw": "{\n  \"kind\": \"message\",\n  \"text\": \"Congratulations! You are hired. Buy equipment with the check we send and reply on Telegram.\",\n  \"senderEmail\": \"hr@postman-{{runId}}.example\",\n  \"channel\": \"EMAIL\"\n}"
