{
  "info": {
    "name": "JobSeance API",
    "description": "Demo and CRUD collection. Logs in once per seeded user (demo, demo2), signs up nobody, and cleans up after itself, so it can run twice in a row. Folder \"★ Demo step 6\" holds demo step 6 in presenting order.\n\nRun: npx newman@6.2.2 run postman/jobseance.postman_collection.json --env-var baseUrl=<URL> [--env-var demoPassword=<seeded password>] [--env-var adminPassword=<ADMIN_USER_PASSWORD>] [--env-var vercelBypass=<secret, previews only>]",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const bypass = pm.variables.get(\"vercelBypass\");",
          "if (bypass) pm.request.headers.upsert({ key: \"x-vercel-protection-bypass\", value: bypass });"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "vercelBypass",
      "value": ""
    },
    {
      "key": "demoPassword",
      "value": "seance-demo-password-dev"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "token2",
      "value": ""
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "demoReportId",
      "value": ""
    },
    {
      "key": "newReportId",
      "value": ""
    },
    {
      "key": "checkId",
      "value": ""
    },
    {
      "key": "scamReportId",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0 · Setup",
      "item": [
        {
          "name": "Health",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"db ok\", () => pm.expect(pm.response.json().db).to.eql(\"ok\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in as demo",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demo\",\n  \"password\": \"{{demoPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"runId\", Date.now().toString(36));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"token\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in as demo2",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demo2\",\n  \"password\": \"{{demoPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"token2\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in as admin (optional)",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Admin requests run as the seeded admin account only when adminPassword is passed; otherwise they expect the 404 everyone else gets.",
                  "if (pm.variables.get(\"adminPassword\")) {",
                  "  pm.test(\"admin login 200\", () => pm.response.to.have.status(200));",
                  "  pm.collectionVariables.set(\"adminToken\", pm.response.json().token);",
                  "} else {",
                  "  pm.test(\"no adminPassword given: admin requests expect 404\", () => pm.expect(pm.response.code).to.be.oneOf([400, 401]));",
                  "  pm.collectionVariables.set(\"adminToken\", \"\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Me (Bearer)",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"is demo\", () => pm.expect(pm.response.json().user.username).to.eql(\"demo\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "★ Demo step 6 (run in this order after \"Log in as demo\")",
      "description": "The five-minute demo, step 6: a check with Authorization: Bearer, then PATCH the demo user's Quietwater report and put it back. Select an environment with baseUrl=https://job-seance.vercel.app and demoPassword=<production demo password> first.",
      "item": [
        {
          "name": "Scan the demo message (Bearer)",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/checks",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"message\",\n  \"senderEmail\": \"talent@bramblecloud-careers.example\",\n  \"companyClaimed\": \"Bramblecloud Software\",\n  \"channel\": \"EMAIL\",\n  \"text\": \"Hello from the Bramblecloud Software hiring team. Your interview will be held by chat on WhatsApp. We will mail you a check to buy equipment from our vendor. Deposit the check by mobile deposit and send the remaining balance to the vendor. Please respond within 24 hours.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"scam risk High\", () => pm.expect(body.scam.band).to.eql(\"HIGH\"));",
                  "pm.test(\"8 warning signs\", () => pm.expect(body.scam.signals.filter((s) => s.points > 0).length).to.eql(8));"
                ]
              }
            }
          ]
        },
        {
          "name": "My reports",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/reports/mine"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const mine = pm.response.json().reports.find(r => r.company.slug === \"quietwater\");",
                  "pm.test(\"has the seeded Quietwater report\", () => pm.expect(mine).to.be.an(\"object\"));",
                  "pm.collectionVariables.set(\"demoReportId\", mine.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update status: Applied → No response",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/reports/{{demoReportId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"outcome\": \"NO_RESPONSE\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"updated\", () => pm.expect(pm.response.json().report.outcome).to.eql(\"NO_RESPONSE\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Put status back to Applied",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/reports/{{demoReportId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"outcome\": \"APPLIED\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"restored\", () => pm.expect(pm.response.json().report.outcome).to.eql(\"APPLIED\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 · Companies (public)",
      "item": [
        {
          "name": "List companies ?q=quiet",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/companies?q=quiet"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"finds Quietwater\", () => pm.expect(pm.response.json().companies.map(c => c.slug)).to.include(\"quietwater\"));",
                  "pm.test(\"no ghost or scam band next to a company\", () => {",
                  "  const text = pm.response.text();",
                  "  pm.expect(text).to.not.match(/ghostBand|scamBand|ghostScore|scamScore/);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Company detail",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/companies/quietwater"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"has community summary\", () => pm.expect(pm.response.json().community).to.have.property(\"reports\"));",
                  "pm.test(\"no ghost or scam band next to a company\", () => {",
                  "  const text = pm.response.text();",
                  "  pm.expect(text).to.not.match(/ghostBand|scamBand|ghostScore|scamScore/);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown company",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/companies/no-such-company"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Add company as non-admin",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token2}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/companies",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Co\",\n  \"officialDomains\": [\n    \"postman.example\"\n  ],\n  \"ats\": \"NONE\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Add company, missing board token",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/companies",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Co\",\n  \"officialDomains\": [\n    \"postman.example\"\n  ],\n  \"ats\": \"GREENHOUSE\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get(\"adminToken\")) {",
                  "  pm.test(\"status 400\", () => pm.response.to.have.status(400));",
                  "  pm.test(\"names the field\", () => pm.expect(pm.response.json().error.fields).to.have.property(\"atsBoard\"));",
                  "} else {",
                  "  pm.test(\"no admin token: refused before validation\", () => pm.expect(pm.response.code).to.be.oneOf([401, 403]));",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 · Outcome reports",
      "item": [
