            "url": "{{baseUrl}}/api/v1/companies",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Co\",\n  \"officialDomains\": [\n    \"postman.example\"\n  ],\n  \"ats\": \"NONE\"\n}"
