          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Add company, missing board token",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/companies",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Co\",\n  \"officialDomains\": [\n    \"postman.example\"\n  ],\n  \"ats\": \"GREENHOUSE\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"names the field\", () => pm.expect(pm.response.json().error.fields).to.have.property(\"atsBoard\"));"
                ]
              }
            }
          ]
        }
      ]
    },
