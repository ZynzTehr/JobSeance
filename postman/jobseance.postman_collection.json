{
  "info": {
    "name": "JobSeance API",
    "description": "Phase 5 CRUD collection. Logs in once per seeded user (demo, demo2), signs up nobody, and cleans up after itself, so it can run twice in a row.\n\nRun: npx newman@6.2.2 run postman/jobseance.postman_collection.json --env-var baseUrl=<URL> --env-var vercelBypass=<secret> [--env-var demoPassword=<seeded password>]",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const bypass = pm.variables.get(\"vercelBypass\");",
          "if (bypass) pm.request.headers.upsert({ key: \"x-vercel-protection-bypass\", value: bypass });"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "vercelBypass",
      "value": ""
    },
    {
      "key": "demoPassword",
      "value": "seance-demo-password-dev"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "token2",
      "value": ""
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "demoReportId",
      "value": ""
    },
    {
      "key": "newReportId",
      "value": ""
    },
    {
      "key": "checkId",
      "value": ""
    },
    {
      "key": "scamReportId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0 · Setup",
      "item": [
        {
          "name": "Health",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"db ok\", () => pm.expect(pm.response.json().db).to.eql(\"ok\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in as demo",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demo\",\n  \"password\": \"{{demoPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"runId\", Date.now().toString(36));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"token\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in as demo2",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demo2\",\n  \"password\": \"{{demoPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"token2\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me (Bearer)",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"is demo\", () => pm.expect(pm.response.json().user.username).to.eql(\"demo\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 · Companies (public)",
      "item": [
        {
          "name": "List companies ?q=quiet",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/companies?q=quiet"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"finds Quietwater\", () => pm.expect(pm.response.json().companies.map(c => c.slug)).to.include(\"quietwater\"));",
                  "pm.test(\"no ghost or scam band next to a company\", () => {",
                  "  const text = pm.response.text();",
                  "  pm.expect(text).to.not.match(/ghostBand|scamBand|ghostScore|scamScore/);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Company detail",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/companies/quietwater"
